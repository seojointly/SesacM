<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" 
    "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<!-- <mapper namespace="Mapper_인터페이스_전체경로"> -->
<mapper namespace="com.example.mybatis.mapper.PostMapper"> <!-- 인터페이스 주소 명시 -->

  <!-- 모든 SELECT 태그는 결과 타입(resultType, resultMap) 명시가 필요합니다. -->
  <!-- insert, update, delete 태그는 결과 타입을 명시하면 오류납니다. -->
  <select id="countAll" resultType="long"> <!-- 자바에서 해당 countAll을 찍을 때 사용-->
    SELECT COUNT(*) FROM users <!--; 붙이면 오류 count 타입: Long (BIGINT 사용했으니까)-->
  </select>

  <resultMap id="postWithUser" type="Post">
    <id property="id" column="post_id"/> <!-- PK라서 해당 명령어 사용 -->
    <result property="userId" column="user_id"/>
    <result property="title" column="title"/>
    <result property="content" column="content"/>
    <result property="createdAt" column="post_created_at"/> <!-- post기준 종료 -->
    <association property="user" javaType="User">
      <id property="id" column="user_id"/>
      <result property="email" column="email"/>
      <result property="nickname" column="nickname"/>
      <result property="createdAt" column="user_created_at"/>
    </association>
  </resultMap>

  <select id="findById" resultMap="postWithUser">
    SELECT
        p.id as post_id, p.user_id, p.title, p.content, p.created_at as post_created_at, 
        u.email, u.nickname, u.created_at as user_created_at
    FROM posts p
    JOIN users u ON p.user_id = u.id
    WHERE p.id=#{id} <!-- 변수처리 설정 -->
  </select>

  <!-- 전체 조회 (Post + User), 최근 게시글 먼저 조회 -->

  <select id="findAll" resultMap="postWithUser">
    SELECT 
        p.id as post_id, p.user_id, p.title, p.content, p.created_at as post_created_at, 
        u.email, u.nickname, u.created_at as user_created_at
    FROM posts p
    JOIN users u ON p.user_id = u.id
    ORDER BY post_id ${sort} <!-- 이것도 동적으로 사용 가능 -> mybatis를 사용하면 좋다. -->
    LIMIT #{offset}, #{size} <!-- "어디서부터, 몇 개" 를 의미  -->
  
  </select>

  <insert id="save" useGeneratedKeys="true" keyProperty="id">
    INSERT INTO posts (user_id, title, content)
    VALUES (#{userId}, #{title}, #{content}) <!-- 변수가 넘어가는 것 -->
    
  </insert>

  <update id="update">
    UPDATE posts
    SET title = #{title},
        content = #{content}
    WHERE id = #{id}
  </update>

  <delete id="deleteById">
    DELETE FROM posts
    WHERE id = #{id}
  </delete>
</mapper>